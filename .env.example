# Environment variables (copy to .env and customize)
ANTICAPTCHA_DATABASE_PATH=data/anticaptcha.db
ANTICAPTCHA_API_PREFIX=/api/v1
ANTICAPTCHA_API_KEY_HEADER=X-API-Key
ANTICAPTCHA_WORKER_POLL_INTERVAL=1
ANTICAPTCHA_MAX_RETRIES=3
ANTICAPTCHA_MODELS_DIR=models
ANTICAPTCHA_YOLO_MODEL=yolov8n-cls.pt
ANTICAPTCHA_HEADLESS=true
ANTICAPTCHA_BROWSER_TIMEOUT=30